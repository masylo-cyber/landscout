# Skopiuj do .env i uzupełnij. install.sh robi to interaktywnie.

# --- baza ---
DB_PASSWORD=zmien_mnie

# --- Anthropic (analiza ofert) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Apify (opcjonalnie: kolektory oparte na aktorach Apify) ---
APIFY_TOKEN=
# hasło Apify Proxy (Console -> Proxy -> Password) – do portali blokujących IP serwerowe (OLX)
APIFY_PROXY_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID czatu; można zostawić puste — agent wykryje po komendzie /start wysłanej do bota
TELEGRAM_CHAT_ID_GALANO=
TELEGRAM_CHAT_ID_BAURO=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- panel WWW ---
PANEL_USER=admin
PANEL_PASSWORD=zmien_mnie

# --- harmonogram (minuty między przebiegami) ---
RUN_INTERVAL_MIN=120
# ile ofert maksymalnie analizować modelem w jednym przebiegu (koszt API)
MAX_LLM_PER_RUN=60
